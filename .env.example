# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.sdkongre.com
NEXT_PUBLIC_SITE_INDEXABLE=false

# -----------------------------------------------------------------------------
# Hero media
# Keep blank to use the included poster fallback.
# Supabase public Storage URLs may be used after setup.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HERO_POSTER=/fallback/hero-poster.svg
NEXT_PUBLIC_HERO_VIDEO_DESKTOP=
NEXT_PUBLIC_HERO_VIDEO_MOBILE=

# -----------------------------------------------------------------------------
# Real company contact information
# Do not enter invented or placeholder public information.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_MOBILE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_WORKING_HOURS=
NEXT_PUBLIC_MAP_URL=

# -----------------------------------------------------------------------------
# Social media
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# -----------------------------------------------------------------------------
# Supabase
# Recommended current key names:
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallback keys are also supported by the code, but new projects should
# use the publishable and secret keys above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Form notification and security
# -----------------------------------------------------------------------------
CONTACT_TO_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
RATE_LIMIT_SALT=
CRON_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Analytics — loaded only after cookie consent
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
